<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Local Ollama LLM Chat</title>


    <!-- Markdown renderer -->
    <script
        src="https://cdn.jsdelivr.net/npm/marked/marked.min.js">
    </script>


    <!-- HTML sanitizer -->
    <script
        src="https://cdn.jsdelivr.net/npm/dompurify/dist/purify.min.js">
    </script>


    <style>

        body {
            font-family: Arial, sans-serif;

            max-width: 800px;

            margin: 40px auto;

            padding: 0 20px;
        }


        #chat {
            border: 1px solid #ccc;

            padding: 20px;

            min-height: 300px;

            max-height: 650px;

            overflow-y: auto;

            margin-bottom: 20px;
        }


        .user {
            margin: 15px 0;

            font-weight: bold;
        }


        .assistant {
            margin: 15px 0 25px 0;
        }


        .assistant p {
            margin: 8px 0;
        }


        .assistant pre {
            background: #f4f4f4;

            padding: 12px;

            overflow-x: auto;
        }


        .assistant code {
            background: #f4f4f4;

            padding: 2px 4px;
        }


        .loading {
            margin: 15px 0;

            font-style: italic;
        }


        #input-area {
            display: flex;

            gap: 8px;
        }


        input {
            flex: 1;

            padding: 12px;

            font-size: 16px;
        }


        button {
            padding: 12px 20px;

            cursor: pointer;
        }


        button:disabled {
            cursor: not-allowed;
        }

    </style>

</head>


<body>


    <h1>
        Local Ollama LLM Chat
    </h1>


    <div id="chat"></div>


    <div id="input-area">

        <input
            id="message"
            type="text"
            placeholder="Ask the local LLM something..."
            autocomplete="off"
        >

        <button
            id="send-button"
            onclick="sendMessage()"
        >
            Send
        </button>

    </div>



<script>


/*
    Conversation history.

    It exists only in browser memory.

    Refreshing the page clears it.
*/
const messages = [];



function scrollToBottom() {

    const chat =
        document.getElementById("chat");

    chat.scrollTop =
        chat.scrollHeight;
}



/*
    Display user message safely as plain text.
*/
function addUserMessage(message) {

    const chat =
        document.getElementById("chat");


    const div =
        document.createElement("div");


    div.className = "user";


    div.textContent =
        "You: " + message;


    chat.appendChild(div);


    scrollToBottom();
}



/*
    Create an empty assistant message.

    During streaming, this same element will
    be updated repeatedly instead of creating
    one new element for every chunk.
*/
function createAssistantMessage() {

    const chat =
        document.getElementById("chat");


    const div =
        document.createElement("div");


    div.className = "assistant";


    chat.appendChild(div);


    scrollToBottom();


    return div;
}



/*
    Render the assistant's accumulated text.

    We render the FULL accumulated answer each time.

    Example:

    chunk 1:
    "Kubernetes"

    chunk 2:
    " is"

    chunk 3:
    " a system"

    accumulated:
    "Kubernetes is a system"

    Markdown is then rendered again from the
    accumulated text.
*/
function renderAssistantMarkdown(
    element,
    message
) {

    /*
        Clean the strange encoded-space text
        occasionally generated by the model.
    */
    const cleanedMessage =
        message.replace(
            /&amp;#x20;|&#x20;/g,
            " "
        );


    const markdownHtml =
        marked.parse(
            cleanedMessage
        );


    const safeHtml =
        DOMPurify.sanitize(
            markdownHtml
        );


    element.innerHTML =
        safeHtml;


    scrollToBottom();
}



/*
    Temporary loading indicator.
*/
function addLoadingMessage() {

    const chat =
        document.getElementById("chat");


    const div =
        document.createElement("div");


    div.className = "loading";


    div.textContent =
        "Assistant is thinking...";


    chat.appendChild(div);


    scrollToBottom();


    return div;
}



/*
    Send conversation history to FastAPI.

    FastAPI now returns a STREAM instead of
    one JSON object.
*/
async function sendMessage() {

    const input =
        document.getElementById("message");


    const sendButton =
        document.getElementById("send-button");


    const message =
        input.value.trim();


    if (!message) {
        return;
    }



    /*
        Save user message into conversation history.
    */
    messages.push({

        role: "user",

        content: message

    });



    addUserMessage(message);



    input.value = "";


    input.disabled = true;

    sendButton.disabled = true;



    const loadingDiv =
        addLoadingMessage();



    let assistantDiv = null;

    let assistantText = "";


    try {


        const response =
            await fetch("/chat", {

                method: "POST",

                headers: {

                    "Content-Type":
                        "application/json"

                },

                body: JSON.stringify({

                    messages: messages

                })

            });



        if (!response.ok) {

            throw new Error(
                "HTTP error: "
                + response.status
            );

        }



        /*
            response.body is a ReadableStream.

            This is different from:

            await response.json()

            because we do NOT wait for the entire
            response anymore.
        */
        if (!response.body) {

            throw new Error(
                "Streaming response body is unavailable."
            );

        }



        const reader =
            response.body.getReader();


        const decoder =
            new TextDecoder();



        /*
            Read chunks until the stream ends.
        */
        while (true) {


            const {
                value,
                done
            } = await reader.read();



            if (done) {
                break;
            }



            /*
                Convert binary bytes into text.
            */
            const chunk =
                decoder.decode(
                    value,
                    {
                        stream: true
                    }
                );



            /*
                The first real chunk means the model
                has started answering.

                Remove:

                Assistant is thinking...
            */
            if (!assistantDiv) {

                loadingDiv.remove();


                assistantDiv =
                    createAssistantMessage();

            }



            /*
                Add new text to the complete answer.
            */
            assistantText += chunk;



            /*
                Update the SAME assistant message.

                This creates the streaming effect.
            */
            renderAssistantMarkdown(
                assistantDiv,
                assistantText
            );

        }



        /*
            Flush anything remaining inside
            TextDecoder.
        */
        assistantText +=
            decoder.decode();



        if (
            assistantDiv &&
            assistantText
        ) {

            renderAssistantMarkdown(
                assistantDiv,
                assistantText
            );

        }



        /*
            Only after streaming is finished do we
            save the completed assistant response
            into conversation history.
        */
        messages.push({

            role: "assistant",

            content: assistantText

        });


    }

    catch (error) {


        console.error(error);



        if (
            loadingDiv.isConnected
        ) {

            loadingDiv.remove();

        }



        if (
            assistantDiv &&
            assistantText
        ) {

            const errorMessage =
                "\n\n**Streaming interrupted.**";


            assistantText +=
                errorMessage;


            renderAssistantMarkdown(
                assistantDiv,
                assistantText
            );

        }

        else {


            const errorDiv =
                createAssistantMessage();


            renderAssistantMarkdown(
                errorDiv,
                "**Error:** Could not get a response from the server."
            );

        }


    }

    finally {


        if (
            loadingDiv.isConnected
        ) {

            loadingDiv.remove();

        }


        input.disabled = false;

        sendButton.disabled = false;


        input.focus();

    }

}



/*
    Press Enter to send.
*/
document
    .getElementById("message")
    .addEventListener(
        "keydown",
        function(event) {

            if (
                event.key === "Enter"
            ) {

                event.preventDefault();

                sendMessage();

            }

        }
    );


</script>


</body>

</html>