  "components": {
    "schemas": {
      "CreateResearcherRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 1024,
            "minLength": 12,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "CreateResearcherRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobRequest": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Name",
            "default": "fastapi-test"
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "title": "Script"
          },
          "cpus": {
            "type": "integer",
            "maximum": 24.0,
            "minimum": 1.0,
            "title": "Cpus",
            "default": 1
          },
          "memory_mb": {
            "type": "integer",
            "maximum": 30000.0,
            "minimum": 64.0,
            "title": "Memory Mb",
            "default": 512
          },
          "time_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Time Minutes",
            "default": 1
          },
          "gpus": {
            "type": "integer",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Gpus",
            "default": 0
          },
          "gpu_mode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Gpu Mode"
          },
          "mps_share": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Mps Share",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "script"
        ],
        "title": "JobRequest"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "UpdateResearcherStatusRequest": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "UpdateResearcherStatusRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
