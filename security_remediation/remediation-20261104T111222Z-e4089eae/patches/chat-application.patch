 @my_api.middleware("http")
 async def private_responses(request: Request, call_next):
+    if request.method in {"POST", "PUT", "PATCH", "DELETE"}:
+        # Use the ASGI request origin; never trust X-Forwarded-Host here.
+        # Reverse proxies must preserve Host and supply scheme through trusted server config.
+        target = request_origin(f"{request.url.scheme}://{request.url.netloc}")
+        origins = request.headers.getlist("origin")
+        referers = request.headers.getlist("referer")
+        if origins:
+            source = request_origin(origins[0]) if len(origins) == 1 else None
+        else:
+            source = request_origin(referers[0], referer=True) if len(referers) == 1 else None
+        if target is None or source != target:
+            return JSONResponse(status_code=403,
+                                content={"detail": "Same-origin request required."},
+                                headers={"Cache-Control": "no-store"})
